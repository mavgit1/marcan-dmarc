# Copy to .env (docker compose reads it automatically) and edit.

# Public host name; its DNS record must point at this server, ports 80/443 open.
MARCAN_DOMAIN=dmarc.example.com

# Login. Generate the hash with:
#   docker run --rm -it caddy:2-alpine caddy hash-password
# Keep it in SINGLE quotes: the hash contains "$" characters.
MARCAN_USER=admin
MARCAN_PASSWORD_HASH='$2a$14$replace-with-the-output-of-caddy-hash-password'

# Optional: Marcan image version (default is set in docker-compose.yml)
# MARCAN_VERSION=0.2.1
