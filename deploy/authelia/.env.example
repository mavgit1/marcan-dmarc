# Copy to .env (docker compose reads it automatically) and edit.
# Both host names need DNS records pointing at this server.
MARCAN_DOMAIN=dmarc.example.com
AUTH_DOMAIN=auth.example.com
# A parent domain of both hosts; Authelia's session cookie is set for it.
COOKIE_DOMAIN=example.com

# Three independent secrets, each: openssl rand -hex 32
# Changing the encryption key later makes the stored 2FA registrations unreadable.
AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
