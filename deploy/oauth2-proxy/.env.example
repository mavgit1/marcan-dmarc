# Copy to .env (docker compose reads it automatically) and edit.
MARCAN_DOMAIN=dmarc.example.com

# OIDC client (Okta, Entra ID, Google, Keycloak, ...)
OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=<client-id>
OIDC_CLIENT_SECRET=<client-secret>
# Who may sign in: every signed-in user can change every setting.
# Never "*" with a public provider such as Google.
ALLOWED_EMAIL_DOMAINS=example.com
# Generate with: openssl rand -base64 32
COOKIE_SECRET=<random-secret>

# MARCAN_VERSION=0.2.1
