# Copy to .env (docker compose reads it automatically) and edit.
MARCAN_DOMAIN=dmarc.example.com

# OIDC client (Okta, Entra ID, Google, Keycloak, ...)
OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=<client-id>
OIDC_CLIENT_SECRET=<client-secret>
# Who may sign in: every signed-in user can change every setting.
# Never "*" with a public provider such as Google.
ALLOWED_EMAIL_DOMAINS=example.com
# Generate with: openssl rand -base64 32 | tr -- '+/' '-_'
# (URL-safe: with "+" or "/" in it OAuth2-Proxy refuses to start.)
COOKIE_SECRET=<random-secret>

# Optional: encrypt the mail accounts' credentials in the database. Generate with:
#   openssl rand -base64 32
# Keep it apart from the backups of the data volume: without it the stored
# credentials cannot be read and must be entered again. Leave it out for no
# encryption. To keep it out of the container's environment, use a Docker
# secret instead (MARCAN_SECRET_KEY_FILE in docker-compose.yml).
# MARCAN_SECRET_KEY=
# Only while changing the key: the old one here, the new one above; remove it
# after the next start (which encrypts the credentials again with the new one).
# MARCAN_SECRET_KEY_PREVIOUS=
