# Marcan behind Caddy with HTTP basic auth (the default deployment).
# Caddy terminates TLS (automatic HTTPS) and is the only thing that talks to the
# internet. Marcan has no login of its own, so every route except /healthz
# requires the basic-auth user below.

{$MARCAN_DOMAIN} {
    encode gzip zstd

    # Liveness probe for uptime monitors: answers "ok", no login, no details.
    # Everything else, /api/system/health included, needs a login.
    handle /healthz {
        reverse_proxy marcan:8080
    }

    handle {
        basic_auth {
            # user, then a bcrypt hash made with `caddy hash-password`
            {$MARCAN_USER} {$MARCAN_PASSWORD_HASH}
        }
        reverse_proxy marcan:8080
    }
}
